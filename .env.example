# Токен бота MAX (обязательно)
MAX_TOKEN=

# Ключ авторизации GigaChat (необязательно, без него бот работает на шаблонах)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Часовой пояс по умолчанию (UTC+12 — Камчатка), если ученик не выбрал свой
TZ_OFFSET=12

# Время ежедневного напоминания по плану
PLAN_REMINDER_TIME=15:30

# Адрес API MAX
MAX_API_URL=https://platform-api2.max.ru

# Файл базы данных
DB_PATH=data/school_helper.db
